<Window x:Class="ElektroBud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Magazynowy Elektro-Bud" Height="620" Width="980"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Magazyn Elektro-Bud" FontSize="22" FontWeight="Bold" Foreground="#1A365D" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="#EDF2F7" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="FormHeaderText" Text="Dodaj nowy produkt" FontSize="15" FontWeight="Bold" Foreground="#2B6CB0" Margin="0,0,0,10"/>

                <UniformGrid Columns="4" Rows="2">
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Kod EAN (8-13 cyfr):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="EanTextBox" MaxLength="13" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Nazwa produktu:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameTextBox" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Kategoria:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox" Padding="5" SelectedIndex="0">
                            <ComboBoxItem Content="Kable i przewody"/>
                            <ComboBoxItem Content="Aparatura modułowa"/>
                            <ComboBoxItem Content="Oświetlenie"/>
                            <ComboBoxItem Content="Materiały budowlane"/>
                            <ComboBoxItem Content="Elektronarzędzia"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Ilość (szt.):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="QuantityTextBox" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Sektor:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="SectorTextBox" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Regał:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="RackTextBox" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Półka:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShelfTextBox" Padding="5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="SaveButton" Content="Dodaj produkt" Width="115" Height="30" Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SaveButton_Click"/>
                        <Button x:Name="CancelButton" Content="Anuluj" Width="75" Height="30" Margin="8,0,0,0" Background="#718096" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="CancelButton_Click"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Szukaj (EAN lub nazwa):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchTextBox" Grid.Column="1" Padding="5" TextChanged="SearchTextBox_TextChanged"/>

            <Button Grid.Column="3" Content="Edytuj zaznaczony" Width="130" Height="30" Margin="0,0,8,0" Background="#D69E2E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="EditButton_Click"/>
            <Button Grid.Column="4" Content="Usuń zaznaczony" Width="130" Height="30" Background="#E53E3E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="DeleteButton_Click"/>
        </Grid>

        <DataGrid x:Name="ProductsDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" RowHeaderWidth="0" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Kod EAN" Binding="{Binding Ean}" Width="130"/>
                <DataGridTextColumn Header="Nazwa produktu" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="160"/>
                <DataGridTextColumn Header="Lokalizacja" Binding="{Binding FullLocation}" Width="140"/>
                <DataGridTextColumn Header="Ilość (szt.)" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>